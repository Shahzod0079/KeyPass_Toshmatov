<Page x:Class="AppKeyPass.Pages.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppKeyPass.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Register" Background="White">

    <Grid>
        <StackPanel Width="220" Height="250">
            <Label Content="Регистрация" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
            <Label Content="Логин" Height="25" />
            <TextBox x:Name="tbLogin" Height="25"/>
            <Label Content="пароль" Height="25"/>
            <PasswordBox x:Name="tbPassword" Height="25"/>
            <Label Content="Подтверждение пароля" Height="25"/>
            <PasswordBox x:Name="tbConfirmPassword" Height="25"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Click="BtnBack" Content="Назад" Height="25" Width="90"  Margin="0,0,10,0"/>
                <Button Click="BtnRegister" Content="Зарегистрироваться" Height="25" Width="120"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
